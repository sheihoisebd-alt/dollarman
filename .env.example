# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Variables are declared and validated in src/env.ts.

# ── Public (inlined into the static pages at build time; redeploy after changing) ──
PUBLIC_SITE_URL=https://dollarmanlearning.com
# Telegram channel where the live classes are held: username only, e.g. dollarman4178 (links go to https://t.me/<channel>)
PUBLIC_TELEGRAM_CHANNEL=
# Meta Pixel ID (Events Manager → Data sources). Empty = Pixel and Conversions API disabled.
PUBLIC_META_PIXEL_ID=

# ── Private (server only, read at runtime) ──
# Conversions API access token (Events Manager → your Pixel → Settings → Generate access token)
META_CAPI_ACCESS_TOKEN=
# Graph API version used for /events. Check the current version in Meta's docs.
META_API_VERSION=v24.0
# Events Manager → Test events → test code (e.g. TEST12345). Leave empty in production.
META_TEST_EVENT_CODE=

# ── SQLite content database (generated by `npm run db:build`) ──
DATABASE_PATH=data/content.db
# Keep "true" on Vercel (read-only filesystem). Set "false" only on a VPS with a persistent volume.
DATABASE_READONLY=true
